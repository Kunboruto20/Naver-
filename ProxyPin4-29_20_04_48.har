,"queryString":[{"name":"m","value":"showDeviceList"},{"name":"token_help","value":"a6FMbj88MhsfCTC1"}],"postData":{"mimeType":""},"headersSize":-1,"bodySize":-1},"cache":{},"timings":{"send":0,"wait":523,"receive":0},"serverIPAddress":"125.209.233.29","response":{"status":200,"statusText":"Connection established","httpVersion":"HTTP/2","cookies":[],"headers":[{"name":"date","value":"Wed, 29 Apr 2026 17:04:24 GMT"},{"name":"content-type","value":"text/html;charset=UTF-8"},{"name":"vary","value":"Accept-Encoding"},{"name":"p3p","value":"CP=\"ALL CURa ADMa DEVa TAIa OUR BUS IND PHY ONL UNI PUR FIN COM NAV INT DEM CNT STA POL HEA PRE LOC OTC\""},{"name":"set-cookie","value":"NID_; expires=Fri, 29 May 2026 17:04:24 GMT; path=/; domain=.naver.com"},{"name":"x-frame-options","value":"SAMEORIGIN"},{"name":"strict-transport-security","value":"max-age=15768000"},{"name":"content-security-policy-report-only","value":"script-src static.nid.naver.com mail.naver.com ntm.pstatic.net api-talks.naver.com ssl.pstatic.net 'unsafe-inline' 'self'; img-src 'self' data: ssl.pstatic.net phinf.pstatic.net ndevthumb-phinf.pstatic.net sp.naver.com static.nid.naver.com lcs.naver.com cc.naver.com soundcaptcha.naver.com captcha.naver.com soundcaptcha.nid.naver.com captcha.nid.naver.com; media-src 'self' soundcaptcha.naver.com soundcaptcha.nid.naver.com captcha.nid.naver.com captcha.naver.com; object-src 'self'; report-uri https://nid.naver.com/login/api/csp.repo.naver.only;"},{"name":"content-security-policy","value":"script-src static.nid.naver.com mail.naver.com ntm.pstatic.net api-talks.naver.com ssl.pstatic.net 'unsafe-eval' 'unsafe-inline' 'self'; img-src 'self' data: ssl.pstatic.net phinf.pstatic.net ndevthumb-phinf.pstatic.net sp.naver.com static.nid.naver.com lcs.naver.com cc.naver.com soundcaptcha.naver.com captcha.naver.com soundcaptcha.nid.naver.com captcha.nid.naver.com; media-src 'self' soundcaptcha.naver.com soundcaptcha.nid.naver.com captcha.nid.naver.com captcha.naver.com; object-src 'self' 'unsafe-inline'; report-uri https://nid.naver.com/login/api/csp.repo.naver;"},{"name":"x-content-type-options","value":"nosniff"},{"name":"x-xss-protection","value":"1; mode=block"},{"name":"content-language","value":"ro-RO"},{"name":"cache-control","value":"no-store, no-cache, must-revalidate"},{"name":"content-encoding","value":"gzip"},{"name":"referrer-policy","value":"unsafe-url"},{"name":"server","value":"nfront"}],"content":{"size":4439,"mimeType":"text/html","text":"<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n<meta charset=\"utf-8\">\r\n<meta id=\"viewport\" name=\"viewport\" content=\"width=device-width,initial-scale=1.0\">\r\n<title>2-step Verification : Select a device</title>\r\n<link href=\"https://nid.naver.com/favicon_1024.png\" rel=\"apple-touch-icon-precomposed\" sizes=\"1024x1024\" /> \r\n<link rel=\"stylesheet\" type=\"text/css\" />\r\n<link rel=\"stylesheet\" type=\"text/css\" href=\"/inc/mobile/css/myInfo_mobile.css?r=2604161\">\r\n\r\n<script type=\"text/javascript\" src=\"/inc/common/js/jquery.min.js\"></script>\r\n<script type=\"text/javascript\" src=\"/inc/mobile/js/browserMyInfo.js?20251208\"></script>\r\n<script type=\"text/javascript\" src=\"https://nid.naver.com/inc/mobile/js/en/commonUtil.js?20240221\"></script>\r\n<script type=\"text/javascript\" src=\"/inc/common/js/nlog.js?r=202512241\"></script>\r\n<script type=\"text/javascript\" src=\"/inc/common/js/lua.js?r=20220411\"></script>\r\n\r\n<script type=\"text/javascript\">\t\r\n</script>\r\n<meta name=\"decorator\" content=\"MOBILE_NEW_MYINFO\">\r\n</head>\r\n<body id=\"mainBody\" class=\"\" onload=\"setTimeout(function() { window.scrollTo(0, 1) }, 100);\">\r\n<div id=\"wrap\">\r\n\t<div class=\"u_skip\"><a href=\"#content\">본문 바로가기</a></div>\r\n\t<!-- header -->\r\n\t<header role=\"banner\">\r\n<div class=\"header_subindex\">\n\t<!--N로고/네이버ID-->\n\t<div class=\"gnb_area\">\n\t\t<a href=\"https://m.naver.com\" class=\"logo\">\n\t\t\t<span class=\"blind\">NAVER</span>\n\t\t</a>\n\t\t<a href=\"javascript:;\" id=\"accountInfo\" class=\"gnb_title\">\n\t\t\t<h1 class=\"text\">\n\t\t\t\t<span class=\"blind\">네이버ID</span>\n\t\t\t</h1>\n\t\t</a>\n\t</div>\n\t<nav class=\"lnb\">\n\t\t<div class=\"lnb_area\">\n\t\t\t<ul class=\"lnb_list\" role=\"menu\">\n\t\t\t\t<li>\n\t\t\t\t\t<a href=\"javascript:;\" class=\"lnb_item\" role=\"menuitem\">\n\t\t\t\t\t\t<div id=\"nid\" class=\"lnb_text\">My Profile</div>\n\t\t\t\t\t</a>\n\t\t\t\t</li>\n\t\t\t\t<li>\n\t\t\t\t\t<a href=\"javascript:;\" class=\"lnb_item\" role=\"menuitem\">\n\t\t\t\t\t\t<div id=\"security\" class=\"lnb_text\">Security</div>\n\t\t\t\t\t</a>\n\t\t\t\t</li>\n\t\t\t\t<li>\n\t\t\t\t\t<a href=\"javascript:;\" class=\"lnb_item\" role=\"menuitem\">\n\t\t\t\t\t\t<div id=\"manageHistory\" class=\"lnb_text\">Manage History</div>\n\t\t\t\t\t</a>\n\t\t\t\t</li>\n\t\t\t</ul>\n\t\t</div>\n\t</nav>\n</div>\n\n<script type=\"text/JavaScript\">\nvar isMobile = {\n\tiOS: function () {\n\t\t\t return navigator.userAgent.match(/iPhone|iPod/i);\n\t},\n\tiPad: function () {\n\t\t\t return navigator.userAgent.match(/iPad/i);\n\t}\n};\n\nfunction toggleMenu(currentMenu) {\n    var tagList, otherMenu, i;\n\n    if(currentMenu == \"\" || typeof currentMenu == \"undefined\"){\n        $(\"#nid\").addClass(\"on\");\n        return;\n    }\n\n    tagList = \"nid security manageHistory \";\n    otherMenu = tagList.split(\" \");\n\n    for (i = 0; i < otherMenu.length; i++) {\n        if(currentMenu == otherMenu[i]){\n            $(\"#\" + otherMenu[i]).addClass(\"on\");\n        }else if(otherMenu[i].replace(/^\\s+/, \"\") != \"\") {\n            $(\"#\" + otherMenu[i]).removeClass(\"on\");\n        }\n    }\n};\n\n$(document).ready(function() {\n\tvar menu;\n\n\tmenu = \"security\";\n\n\tif(menu == \"\" || menu == \"null\" || menu == null){\n\t\tmenu = \"nid\";\n\t}\n\n\ttoggleMenu(menu);\n\n\t$(document).on(\"click touchstart\", \"#nid\", function(event){\n\t\t sendNlog(this, event, 'lnb.info');\n\t\t \n\t\t var rurl = \"/user2/help/myInfoV2?m=viewProfile&lang=en_US\";\n\t\t $(location).attr('href',rurl);\t\t\n\t});\n\t\n\t$(document).on(\"click touchstart\", \"#security\", function(event){\n\t\t sendNlog(this, event, 'lnb.protect');\n\t\t \n\t\t var rurl = \"/user2/help/myInfoV2?m=viewSecurity&lang=en_US\";\n\t\t $(location).attr('href',rurl);\t\t\n\t});\n\n\t$(document).on(\"click touchstart\", \"#manageHistory\", function(event){\n\t\t sendNlog(this, event, 'lnb.history');\n\n\t\t var rurl = \"/user2/help/myInfoV2?m=viewManageHistory&lang=en_US\";\n\t\t $(location).attr('href',rurl);\n\t});\n});\n</script>\n    \t</header>\r\n\r\n\t<div id=\"content\" class=\"content\" role=\"main\">\r\n\t\t<!-- content -->\r\n\t\t<form id=\"fm\" name=\"fm\" action=\"/mobile/user/help/2StepVerif?m=sendPushMessageToRegist\" method=\"post\">\n\t\t<input type=\"hidden\" id=\"token_help\" name=\"token_help\" value=\"a6FMbj88MhsfCTC1\">\n\n\t\t<!-- content -->\n\t\t<div id=\"content\" class=\"otp_loginset\" role=\"main\">\n\t\t\t<div class=\"section section_pwconfirm\">\n\n\t\t\t\t<!-- 2단계 인증 설정하기 - 기기선택 -->\n\t\t\t\t<div class=\"sh_group\">\n\t\t\t\t\t<div class=\"sh_header\">\n\t\t\t\t\t\t<h2>Select a device for 2-Step Verification</h2>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"otp_device_subtitle\">\n\t\t\t\t\t\t<p class=\"tit\">Available Devices</p>\n\t\t\t\t\t\t<div class=\"otp_reload_btn\">\n\t\t\t\t\t\t\t<button id=\"reloadButton\" type=\"button\" class=\"otp_device_reload\">\n\t\t\t\t\t\t\t\t<span class=\"ico_reload\"></span>\n\t\t\t\t\t\t\t\t<span>Reload</span>\n\t\t\t\t\t\t\t</button>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<ul class=\"otp_device_box\">\n\t\t\t\t\t\t<li>\n\t\t\t\t\t\t\t<span class=\"otp_device_radio\">\n\t\t\t\t\t\t\t\t<input type=\"hidden\" name=\"pushToken\" id=\"device_0_token\" value=\"c0ly4djfBLk:APA91bHlJw8NMMZt0-Mj6_7NQXpfnnoYD1GtqZp4mNtwJYhHkIooDJrb4XS_tygZ_9-Epiokc7K3fSEi9_jehudELbuNCwhKiw3iaMWuTS9cGktmVhZbEto\" disabled=\"disabled\"/>\n\t\t\t\t\t\t\t\t<input type=\"radio\" id=\"device_0\" name=\"device\"  data-android=\"true\">\n\t\t\t\t\t\t\t\t<label for=\"device_0\" class=\"otp_device_txt\">\n\t\t\t\t\t\t\t\t\t<span class=\"ico_radio\"></span>\n\t\t\t\t\t\t\t\t\t<span class=\"txt_radio\">Redmi 9C NFC <em class=\"txt_accessday\">(Login : 2026. 04. 30.)</em></span>\n\t\t\t\t\t\t\t\t</label>\n\t\t\t\t\t\t\t\t<button type=\"button\" id=\"btn_delete_0\" class=\"txt_del\">[Delete]</button>\n\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t\t<li>\n\t\t\t\t\t\t\t<span class=\"otp_device_radio\">\n\t\t\t\t\t\t\t\t<input type=\"radio\" id=\"no_device\" name=\"device\">\n\t\t\t\t\t\t\t\t<label for=\"no_device\" class=\"otp_device_txt\">\n\t\t\t\t\t\t\t\t\t<span class=\"ico_radio\"></span>\n\t\t\t\t\t\t\t\t\t<span class=\"txt_radio\">Can’t find your device?</span>\n\t\t\t\t\t\t\t\t</label>\n\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t</ul>\n\t\t\t\t\t<div class=\"btn_area\">\n\t\t\t\t\t\t<span class=\"btn_unit_box\"><button type=\"button\" id=\"prevButton\" class=\"btn_unit\">Previous</button></span>\n\t\t\t\t\t\t<span class=\"btn_unit_box\"><button type=\"button\" id=\"submitButton\" class=\"btn_unit on\">Next</button></span>\n\t\t\t\t\t</div>\n\t\t\t\t\t<p class=\"tit_guide_link\">Check!</p>\n\t\t\t\t\t<ul class=\"check_guide_link\">\n                        <li>After deleting the device, proceed to ‘Sign out’ of the device you deleted from <a id=\"linkHelp2\" href=\"/mobile/user/help/userLoginLog?m=viewLoginStatus&lang=en_US\" class=\"blue_underline\" target=\"_blank\">here</a> to protect your account.</li>\n\t\t\t\t\t\t<li>If you set the push notification setting of Naver App or Device OS to OFF, you will not receive notification of verification.</li>\n\t\t\t\t\t\t<li>Only when the time setting of the verification device is “Auto”, verification proceeds normally. Be sure to check the time setting.</li>\n\t\t\t\t\t\t\n\t\t\t\t\t</ul>\n\t\t\t\t</div>\n\t\t\t\t<!-- // 2단계 인증 설정하기 - 기기선택 -->\n\t\t\t</div>\n\t\t</div>\n\t\t<!-- //content -->\n\t</form>\n\n    <div id=\"noDevicePopup\" class=\"pop_dim\" style=\"display:none;\" tabindex=\"-1\">\n        <div id=\"noDeviceDialog\" class=\"otp_popup\" role=\"dialog\" aria-hidden=\"false\">\n            <h2 class=\"title\">If you do not have the device you want</h2>\n            <p class=\"desc_query\">If the device you want is not listed in the list of 2-step verification devices, please check below.</p>\n            <p class=\"sub_title\">1. Update the Naver app of the device that receives the verification notification to the latest version.</p>\n            <p class=\"sub_title\">2. In the latest version of Naver App, sign in with the account for which you want to set up 2-step verification.</p>\n            <p class=\"sub_title\">3. Please make sure that “Call” is possible with this device. If there is no USIM or there is no call function like the iPad, OTP verification information can not be generated.</p>\n            <p class=\"desc_query\">\n\t\t\t\t\t\t\t\tIt is exposed to the equipment list only when the above three items are completed.<br> Complete your sign in on your device and select \"Reload device list\", or refresh the page to see your device list again.\n\t\t\t\t\t\t\t</p>\n            <div class=\"btn_area\">\n                <span class=\"btn_unit_box\"><button id=\"closeButton\" type=\"button\" class=\"btn_unit\">Close</button></span>\n                <span class=\"btn_unit_box\"><button id=\"refreshButton\" type=\"button\" class=\"btn_unit on\">Reload</button></span>\n            </div>\n        </div>\n    </div>\n\n\t<script type=\"text/javascript\">\n\t\tconst nlogLang = \"en\";\n\t\tnlogInit(\"Mmy.private\", \"release\", false, nlogLang);\n\n\t\t$(document).ready(function(){\n\t\t\t$(\"#linkHelp\").click(function() {\n\t\t\t\tsendNlog(this, event, '2fs.devicehelp1');\n\t\t\t});\n\n\t\t\t$(\"#linkHelp2\").click(function() {\n\t\t\t\tsendNlog(this, event, '2fs.devicehelp2');\n\t\t\t});\n\n\t\t\t$(\"#prevButton\").click(function() {\n\t\t\t\tsendNlog(this, event, '2fs.deviceprevious');\n\t\t\t\tdocument.location.href = \"/mobile/user/help/2StepVerif?m=viewGuide&token_help=a6FMbj88MhsfCTC1\";\n\t\t\t});\n\n\t\t\t$('input:radio[name=device]').change(function () {\n\t\t\t\tif($(this).attr(\"id\") != 'no_device') {\n\t\t\t\t\tsendNlog(this, event,  '2fs.deviceselectradio', '', '', event);\n\t\t\t\t}\n\t\t\t});\n\n\t\t\t$(\"#no_device\").click(function() {\n\t\t\t\tsendNlog(this, event, '2fs.deviceselectnoradio');\n\t\t\t\tshowNoDeviceMessage();\n\t\t\t});\n\n\t\t\t$('#closeButton').click(function() {\n\t\t\t\tsendNlog(this, event, '2fs.deviceclose');\n\t\t\t\thideNoDeviceMessage();\n\t\t\t});\n\n\t\t\t$(\"#refreshButton\").click(function() {\n\t\t\t\tsendNlog(this, event, '2fs.devicerefresh');\n\t\t\t\trefreshPage();\n\t\t\t});\n\n\t\t\t$(\"#reloadButton\").click(function() {\n\t\t\t\tsendNlog(this, event, '2fs.devicereload');\n\t\t\t\trefreshPage();\n\t\t\t});\n\n\n\t\t\t$(\"#btn_delete_0\").click(function() {\n\t\t\t\tsendNlog(this, event, '2fs.devicedelete');\n\n\t\t\t\tvar deviceId = \"893be440788d8301df5452570e878177\";\n\t\t\t\tdeleteAndRefreshPage(deviceId);\n\t\t\t});\n\n\t\t\t$(\"#submitButton\").click(function () {\n\t\t\t\tsendNlog(this, event, '2fs.devicenext');\n\t\t\t\tif (!getLock()) {\n\t\t\t\t\treturn false;\n\t\t\t\t}\n\n\t\t\t\tif (!submit()) {\n\t\t\t\t\treleaseLock();\n\t\t\t\t\treturn false;\n\t\t\t\t}\n\t\t\t});\n\t\t});\n\n\t\t// 중복 submit 방지\n\t\tvar submitFlag = false;\n\t\tfunction getLock(){\n\t\t\tif (submitFlag) {\n\t\t\t\treturn false;\n\t\t\t}\n\t\t\tsubmitFlag = true;\n\t\t\treturn true;\n\t\t}\n\n\t\tfunction releaseLock() {\n\t\t\tsubmitFlag = false;\n\t\t}\n\n\t\tfunction showCannotDeleteAlert() {\n\t\t\tvar alertMsg = \"This device cannot be deleted. Please change the other device to 2-Step Verification and try again.\";\n\t\t\talert(alertMsg);\n\t\t\treturn false;\n\t\t}\n\n\t\tfunction showNoDeviceMessage() {\n\t\t\t$('#noDeviceDialog').attr('aria-hidden', 'false');\n\t\t\t$('#noDevicePopup').show();\n\t\t}\n\n\t\tfunction hideNoDeviceMessage() {\n\t\t\t$('#noDevicePopup').hide();\n\t\t\t$('#noDeviceDialog').attr('aria-hidden', 'true');\n\t\t}\n\n\t\tfunction refreshPage() {\n\t\t\tdocument.location.href=\"/mobile/user/help/2StepVerif?m=showDeviceList&token_help=a6FMbj88MhsfCTC1\";\n\t\t}\n\n\t\tfunction deleteAndRefreshPage(deviceId) {\n\t\t\tdocument.location.href=\"/mobile/user/help/2StepVerif?m=showDeviceList&token_help=a6FMbj88MhsfCTC1&deviceId=\"+deviceId;\n\t\t}\n\n\t\tfunction submit() {\n\t\t\tvar selectedDeviceId = $('input[name=device]:checked', '#fm').attr('id');\n\t\t\tif (!selectedDeviceId) {\n\t\t\t\talert(\"You have not selected a device for 2-step verification. Please select which device to use for verification.\");\n\t\t\t\treturn false;\n\t\t\t}\n\n\t\t\tif (selectedDeviceId == 'no_device') {\n\t\t\t\tshowNoDeviceMessage();\n\t\t\t\treturn false;\n\t\t\t}\n\n\t\t\t// 동일한 기기를 선택한 경우\n\t\t\tif ('sendPushMessageToRegist' == 'sendPushMessageToChange' && document.getElementById(selectedDeviceId + \"_selected\")) {\n\t\t\t\tif (!confirm(\"\")) {\n\t\t\t\t\treturn false;\n\t\t\t\t}\n\t\t\t}\n\n\t\t\t$(\"#\" + selectedDeviceId + \"_token\").prop(\"disabled\", false);\n\n\t\t\tdocument.getElementById(\"fm\").submit();\n\t\t\treturn true;\n\t\t}\n\n\t\twindow.onpageshow = function () {\n\t\t\t$('input:radio[name=device]:checked').trigger('click');\n\t\t}\n\t</script>\r\n\t\r\n\t\t<!-- footer -->\r\n<hr>\r\n\t<footer class=\"footer\" role=\"contentinfo\">\r\n\t\t<p class=\"u_ftlkw\">\r\n\t\t\t\t \t<a href=\"#dummy\" id=\"logout\" class=\"u_ftlk\">Sign-out</a>\r\n\t\t</p>\r\n\t\t\r\n\t\t<p class=\"u_crt\">\r\n\t\t\t<span class=\"u_cri\"><a href=\"#dummy\" id=\"navercorp\" class=\"u_cra u_cra_v1\">&copy;NAVER Corp.</a></span>\r\n\t\t\t<span class=\"u_cri\"><a href=\"#dummy\" id=\"help\" class=\"u_cra\">help</a></span>\r\n\t\t</p>\r\n\t</footer>\r\n<script type=\"text/javascript\">\r\n$(document).ready(function() {\r\n\t$(document).on(\"click touchstart\", \"#navercorp\", function(event){\r\n\t\t sendNlog(this, event, 'fot.navercorp');\r\n\t\t \r\n\t     rurl =\"http://www.navercorp.com/ko/index.nhn\";\r\n\t\t $(location).attr('href',rurl);\t\t\r\n\t});\r\n\t\r\n\t$(document).on(\"click touchstart\", \"#help\", function(event){\r\n\t\tsendNlog(this, event, 'fot.help');\r\n\r\n\t\trurl =\"https://help.naver.com/alias/membership/p.membership/main.naver\";\r\n\t\t$(location).attr('href',rurl);\r\n\t});\r\n\t\r\n\t$(document).on(\"click touchstart\", \"#errorreport\", function(event){\r\n\t\t sendNlog(this, event, 'fot.errorreport');\r\n\t\t \r\n\t     rurl =\"https://m.help.naver.com/support/alias/membership/m.membership/m.membership_12.naver\";\r\n\t\t $(location).attr('href',rurl);\t\t\r\n\t});\t\r\n\t\r\n\t$(document).on(\"click\", \"#logout\", function(event){\r\n\t\t sendNlog(this, event, 'fot.logout');\r\n\t\r\n\t\t if(confirm(\"Are you sure sign out?\") == true) {\r\n\t     \tvar returnUrl = \"https://nid.naver.com/mobile/user/help/naverProfile?lang=en_US\";\r\n\t     \tvar rurl = \"https://nid.naver.com/nidlogin.logout?svctype=262144&url=\" + returnUrl;\r\n\t\t \t$(location).attr('href',rurl);\r\n\t\t }\r\n\t});\r\n\t\r\n\t$(document).on(\"click\", \"#login\", function(event){\r\n\t\tsendNlog(this, event, 'fot.login');\r\n\t\r\n     \tvar returnUrl = \"https://nid.naver.com/mobile/user/help/naverProfile?lang=en_US\";\r\n     \tvar rurl = \"https://nid.naver.com/nidlogin.login?svctype=262144&url=\" + returnUrl;\r\n\t \t$(location).attr('href',rurl);\r\n\t});\r\n\r\n\t$(document).on(\"click\", \"#goPC\", function(event){\r\n\t\tsendNlog(this, event, 'fot.gopc');\r\n\r\n     \tvar rurl = \"https://nid.naver.com/user2/help/myInfo?menu=home\";\r\n\t \t$(location).attr('href',rurl);\r\n\t});\r\n\r\n});\t\r\n</script>\t</div>\r\n</div>\r\n<script type=\"text/javascript\">\r\n$(document).ready(function() {\r\n\r\n    $('#goRedirectPage').css('cursor','pointer');\r\n\t$(document).on(\"click touchstart\", \"#goRedirectPage\", function(event){\r\n\t\t sendNlog(this, event, 'gnb.back');\r\n\r\n\t\t var rurl = \"/user2/help/myInfoV2?lang=en_US\";\r\n\t\t $(location).attr('href',rurl);\r\n\t});\r\n\r\n\t$('#accountInfo').css('cursor','pointer');\r\n\t$(document).on(\"click touchstart\", \"#accountInfo\", function(event){\r\n\t\t sendNlog(this, event, 'gnb.my');\r\n\r\n\t\t $(location).attr('href', \"/user2/help/myInfoV2?lang=\" + 'en_US');\r\n\t});\r\n});\r\n</script>\r\n</body>\r\n</html>"},"redirectURL":"","headersSize":-1,"bodySize":4439}},{"startedDateTime":"2026-04-29T17:04:24.381901Z","time":299,"pageref":"ProxyPin","_id":"mokbc6bh","_app":{"id":"com.nhn.android.search","name":"NAVER","path":"com.nhn.android.search","os":"android"},"request":{"method":"POST","url":"https://ntracker-collector.naver.com/nlog/sdk/v1/naverapp/event","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Connection","value":"close"},{"name":"User-Agent","value":"nApps (Android 11; Xiaomi M2006C3MNG; naverapp; 12.6.4)"},{"name":"da-dd","value":"a593e830-df67-4e93-a975-315919bdea15"},{"name":"da-dv","value":"bfccc9a3-b556-1f8c-302c-a8691fba273d"},{"name":"Cookie","value":"GDOT=Y; MM_NEW=2; NAPP_DI=893be440788d8301df5452570e878177; NNB=MIGUV3PJLXYWS; MM_search_homefeed=true; NAC=zJD6BEBFF2m1; NACT=1; bnb_tooltip_shown_payment_v1=true; bnb_tooltip_shown_point_v1=true; m_loc=; DA_DD=a593e830-df67-4e93-a975-315919bdea15; MM_PF=SEARCH; SRT30=1777482022; SRT5=1777482022; nid_inf=1081622261; NID_AUT=ZCP4gMto11VcotK8e++bZjsn9RFxSxarDa89ep72EKxA0xypH34Hw1JoWLRwameB; NID_"},{"name":"Content-Type","value":"application/json; charset=UTF-8"},{"name":"Content-Length","value":"1042"},{"name":"Host","value":"ntracker-collector.naver.com"},{"name":"Accept-Encoding","value":"gzip"}],"queryString":[],"postData":{"mimeType":"application/json; charset=UTF-8","text":"[{\"corp\":\"naver\",\"svc\":\"naverapp\",\"location\":\"korea_real\\/kor