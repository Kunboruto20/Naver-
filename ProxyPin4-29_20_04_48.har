M CNT STA POL HEA PRE LOC OTC\""},{"name":"set-cookie","value":"NID_; expires=Fri, 29 May 2026 17:04:32 GMT; path=/; domain=.naver.com"},{"name":"content-language","value":"ro-RO"},{"name":"cache-control","value":"no-store, no-cache, must-revalidate"},{"name":"content-encoding","value":"gzip"},{"name":"referrer-policy","value":"unsafe-url"},{"name":"server","value":"nfront"}],"content":{"size":2229,"mimeType":"text/html","text":"<!DOCTYPE html>\n<html lang=\"ko\">\n\n<head>\n\t<meta charset=\"utf-8\">\n\t<meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge, chrome=1\">\n\t<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\">\n\t<title>2-step Verification : Certify/Cancel</title>\n\t<link rel=\"stylesheet\" type=\"text/css\" href=\"/inc/user/css/m_login.min.css?v=231120\">\n\t\t<link rel=\"stylesheet\" type=\"text/css\" href=\"/inc/user/css/m_login_dark.min.css?v=231120\">\n</head>\n\n<body class=\"whole_white\">\n<div id=\"wrap\" class=\"wrap\">\n\t<div class=\"u_skip\"><a href=\"#container\">본문 바로가기</a></div>\n\n\t<header id=\"header\" role=\"banner\" class=\"header\">\n\t\t<div class=\"header_inner\">\n\t\t\t<button tyle=\"button\" class=\"btn_back\" id=\"btn_back\"><span class=\"icon_back\"></span></button>\n\t\t\t<div class=\"lang\">\n\t\t\t\t<a href=\"#none\" class=\"lang_select\" id=\"langDiv\" role=\"listbox\" aria-expanded=\"false\">\n\t\t\t\t\t<span class=\"lang_text\" id=\"selectedLang\">한국어</span>\n\t\t\t\t</a>\n\t\t\t\t<ul class=\"lang_list\" id=\"lang_list\" style=\"display: none;\">\n\t\t\t\t\t<li><a href=\"#\" id=\"lang_ko\" class=\"language\"><span class=\"text\">한국어</span></a></li>\n\t\t\t\t\t<li><a href=\"#\" id=\"lang_en\" class=\"language\"><span class=\"text\">English</span></a></li>\n\t\t\t\t\t<li><a href=\"#\" id=\"lang_cn\" class=\"language\"><span class=\"text\">中文(简体)</span></a></li>\n\t\t\t\t\t<li><a href=\"#\" id=\"lang_tw\" class=\"language\"><span class=\"text\">中文(台灣)</span></a></li>\n\t\t\t\t</ul>\n\t\t\t</div>\n\t\t</div>\n\t</header>\n\n\t<div id=\"container\" class=\"container\">\n\n\t\t<div class=\"content\">\n\t\t\t<div class=\"logo_wrap\">\n\t\t\t\t<h1 class=\"logo\"><span class=\"blind\">네이버</span></h1>\n\t\t\t</div>\n\t\t\t<div class=\"login_wrap\">\n\t\t\t\t<div class=\"login_inner\">\n\t\t\t\t\t<div class=\"title_wrap\">\n\t\t\t\t\t\t<h2 class=\"title\">Do you want to allow<br>the 2-Step Verification request?</h2>\n\t\t\t\t\t\t<p class=\"desc\">\n\t\t\t\t\t\t\tPress the button below to allow <em class=\"accent\">uykjgg109</em>&apos;s verification request.\n\t\t\t\t\t\t</p>\n\t\t\t\t\t</div>\n\n\t\t\t\t\t<div class=\"suspend_box\">\n\t\t\t\t\t\t<ul class=\"permit_data\">\n\t\t\t\t\t\t\t<li>\n\t\t\t\t\t\t\t\t<span class=\"item\">Date</span>\n\t\t\t\t\t\t\t\t<span class=\"data\">2026. 04. 30. (GMT+9), 02:04</span>\n\t\t\t\t\t\t\t</li>\n\t\t\t\t\t\t</ul>\n\t\t\t\t\t</div>\n\n\t\t\t\t\t<button type=\"button\" class=\"btn_check\" id=\"doComplete\">\n\t\t\t\t\t\t<span class=\"text\">Yes</span>\n\t\t\t\t\t</button>\n\n\t\t\t\t\t<button type=\"button\" class=\"btn_white\" id=\"doCancel\">\n\t\t\t\t\t\t<span class=\"text\">No</span>\n\t\t\t\t\t</button>\n\n\t\t\t\t\t<div class=\"notice_fold\">\n\t\t\t\t\t\t<button id=\"btn_fold\" type=\"button\" aria-expanded=\"false\" class=\"btn_fold\">\n\t\t\t\t\t\t\t<span class=\"txt\">If you did not make this request,</span>\n\t\t\t\t\t\t</button>\n\t\t\t\t\t\t<ul class=\"fold_list\">\n\t\t\t\t\t\t\t<li class=\"fold_item\">Select “No.”</li>\n\t\t\t\t\t\t\t<li class=\"fold_item\">\n\t\t\t\t\t\t\t\tLog out from unknown devices in <a href=\"/mobile/user/help/userLoginLog?m=viewLoginStatus&lang=en_US\" class=\"lnk_more\"><span class=\"txt\">Login Management</span></a>. And <a href=\"/user2/help/myInfoV2?m=viewSecurity&lang=en_US\" class=\"lnk_more\"><span class=\"txt\">Review your security settings</span></a>.\n\t\t\t\t\t\t\t</li>\n\t\t\t\t\t\t</ul>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n\n\t<footer class=\"footer\" role=\"contentinfo\" id=\"footer\">\n\t\t<div class=\"footer_inner\">\n\t\t\t<ul class=\"footer_list\">\n\t\t\t\t<li><a target=\"_blank\" href=\"https://m.naver.com\" class=\"footer_item\"><span class=\"footer_logo\"><span class=\"blind\">네이버</span></span></a></li>\n\t\t\t\t<li><a target=\"_blank\" href=\"https://m.help.naver.com/support/service/main.nhn?serviceNo=5640\" class=\"footer_item\">\n\t\t\t\t\t\t<span class=\"footer_text\">Help</span>\n\t\t\t\t\t</a></li>\n\t\t\t</ul>\n\t\t</div>\n\t</footer>\n</div>\n<script type=\"text/javascript\">\n\tfunction isIOS()\n\t{\n\t\tvar userAgent = navigator.userAgent.toLowerCase();\n\t\tif ((userAgent.search(\"iphone\") > -1) || (userAgent.search(\"ipad\") > -1) || (navigator.userAgentData && navigator.userAgentData.platform.indexOf('iOS')!==-1))\n\t\t{\n\t\t\treturn true;\n\t\t}\n\t\treturn false;\n\t}\n\tvar cancelCnt = 0;\n\tvar completeCnt = 0;\n\tfunction doCancel(){\n\t\tif (cancelCnt!=0) {\n\t\t\treturn ;\n\t\t}\n\t\tcancelCnt++;\n\t\tif (isIOS())\n\t\t{\n\t\t\twindow.webkit.messageHandlers.TwoFactorInterface.postMessage(\"cancelInCertify\");\n\t\t}\n\t\telse\n\t\t{\n\t\t\twindow.TwoFactorInterface.cancelInCertify();\n\t\t}\n\t}\n\tfunction doComplete(){\n\t\tif (completeCnt!=0) {\n\t\t\treturn ;\n\t\t}\n\t\tcompleteCnt++;\n\t\tif (isIOS())\n\t\t{\n\t\t\twindow.webkit.messageHandlers.TwoFactorInterface.postMessage(\"acceptInCertify\");\n\t\t}\n\t\telse\n\t\t{\n\t\t\twindow.TwoFactorInterface.acceptInCertify();\n\t\t}\n\t}\n\tfunction isObjExist(objName) {\n\t\tvar element = document.getElementById(objName);\n\t\tif (typeof(element) != 'undefined' && element != null){\n\t\t\treturn true;\n\t\t}\n\t\treturn false;\n\t}\n\tfunction addNormalEvent(nclickId,func) {\n\t\tif (isObjExist(nclickId)) {\n\t\t\tvar targetElement = document.getElementById(nclickId);\n\t\t\tif(targetElement.addEventListener) {\n\t\t\t\ttargetElement.addEventListener(\"click\", func);\n\t\t\t} else {\n\t\t\t\ttargetElement.attachEvent(\"onclick\", func);\n\t\t\t}\n\t\t}\n\t}\n\tfunction doLang(){\n\t\tif (document.getElementById(\"langDiv\").getAttribute(\"aria-expanded\")==\"true\") {\n\t\t\tdocument.getElementById(\"langDiv\").setAttribute(\"aria-expanded\", \"false\");\n\t\t\tdocument.getElementById(\"lang_list\").style.display = \"none\";\n\t\t} else {\n\t\t\tdocument.getElementById(\"langDiv\").setAttribute(\"aria-expanded\", \"true\");\n\t\t\tdocument.getElementById(\"lang_list\").style.display = \"block\";\n\t\t}\n\t}\n\tfunction changeLang(langCode) {\n\t\tURLSearch = new URLSearchParams(location.search);\n\t\tURLSearch.set('lang', langCode);\n\t\tnewParam = URLSearch.toString();\n\t\tlocation.href=location.pathname + '?' + newParam;\n\t}\n\tfunction setLang(lang) {\n\t\tif (lang==\"ko_KR\") {\n\t\t\tdocument.getElementById(\"selectedLang\").innerHTML=\"한국어\";\n\t\t} else if (lang==\"en_US\") {\n\t\t\tdocument.getElementById(\"selectedLang\").innerHTML=\"English\";\n\t\t} else if (lang==\"zh-Hans_CN\") {\n\t\t\tdocument.getElementById(\"selectedLang\").innerHTML=\"中文(简体)\";\n\t\t} else if (lang==\"zh-Hant_TW\") {\n\t\t\tdocument.getElementById(\"selectedLang\").innerHTML=\"中文(台灣)\";\n\t\t}\n\t}\n\tfunction doFold() {\n\t\tif (document.getElementById(\"btn_fold\").getAttribute(\"aria-expanded\")==\"true\") {\n\t\t\tdocument.getElementById(\"btn_fold\").setAttribute(\"aria-expanded\", \"false\");\n\t\t} else {\n\t\t\tdocument.getElementById(\"btn_fold\").setAttribute(\"aria-expanded\", \"true\");\n\t\t}\n\t}\n\taddNormalEvent(\"doComplete\", doComplete);\n\taddNormalEvent(\"doCancel\", doCancel);\n\taddNormalEvent(\"btn_back\", doCancel);\n\taddNormalEvent(\"btn_fold\", doFold);\n\taddNormalEvent(\"langDiv\", doLang);\n\taddNormalEvent(\"lang_ko\", function() {changeLang(\"ko_KR\");event.preventDefault();});\n\taddNormalEvent(\"lang_en\", function() {changeLang(\"en_US\");event.preventDefault();});\n\taddNormalEvent(\"lang_cn\", function() {changeLang(\"zh-Hans_CN\");event.preventDefault();});\n\taddNormalEvent(\"lang_tw\", function() {changeLang(\"zh-Hant_TW\");event.preventDefault();});\n\tsetLang('en_US');\n\tif(isIOS()) {\n\t\tdocument.getElementById(\"footer\").style.display = \"none\";\n\t}\n</script>\n</body>\n</html>"},"redirectURL":"","headersSize":-1,"bodySize":2229}},{"startedDateTime":"2026-04-29T17:04:31.335516Z","time":488,"pageref":"ProxyPin","_id":"mokbft5w","_app":{"id":"com.nhn.android.search","name":"NAVER","path":"com.nhn.android.search","os":"android"},"request":{"method":"POST","url":"https://ntracker-collector.naver.com/nlog/sdk/v1/naverapp/event","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Connection","value":"close"},{"name":"User-Agent","value":"nApps (Android 11; Xiaomi M2006C3MNG; naverapp; 12.6.4)"},{"name":"da-dd","value":"a593e830-df67-4e93-a975-315919bdea15"},{"name":"da-dv","value":"bfccc9a3-b556-1f8c-302c-a8691fba273d"},{"name":"Cookie","value":"GDOT=Y; MM_NEW=2; NAPP_DI=893be440788d8301df5452570e878177; NNB=MIGUV3PJLXYWS; MM_search_homefeed=true; NAC=zJD6BEBFF2m1; NACT=1; bnb_tooltip_shown_payment_v1=true; bnb_tooltip_shown_point_v1=true; m_loc=; DA_DD=a593e830-df67-4e93-a975-315919bdea15; MM_PF=SEARCH; SRT30=1777482022; SRT5=1777482022; nid_inf=1081622261; NID_AUT=ZCP4gMto11VcotK8e++bZjsn9RFxSxarDa89ep72EKxA0xypH34Hw1JoWLRwameB; nid_tct=QbPtb3B8MhOeluf4; NID_"},{"name":"Content-Type","value":"application/json; charset=UTF-8"},{"name":"Content-Length","value":"1081"},{"name":"Host","value":"ntracker-collector.naver.com"},{"name":"Accept-Encoding","value":"gzip"}],"queryString":[],"postData":{"mimeType":"application/json; charset=UTF-8","text":"[{\"corp\":\"naver\",\"svc\":\"naverapp\",\"location\":\"korea_real\\/korea\",\"tool\":{\"name\":\"nlog-sdk\",\"ver\":\"2.4.1\"},\"send_ts\":1777482270478,\"usr\":{\"adid\":\"a593e830-df67-4e93-a975-315919bdea15\",\"ssaid\":\"2cd4be5e201e53af\",\"idfv\":\"bfccc9a3-b556-1f8c-302c-a8691fba273d\",\"ni\":\"893be440788d8301df5452570e8