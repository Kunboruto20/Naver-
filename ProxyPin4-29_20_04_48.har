EVa TAIa OUR BUS IND PHY ONL UNI PUR FIN COM NAV INT DEM CNT STA POL HEA PRE LOC OTC\""},{"name":"set-cookie","value":"NID_; expires=Fri, 29 May 2026 17:04:27 GMT; path=/; domain=.naver.com"},{"name":"x-frame-options","value":"SAMEORIGIN"},{"name":"strict-transport-security","value":"max-age=15768000"},{"name":"content-security-policy-report-only","value":"script-src static.nid.naver.com mail.naver.com ntm.pstatic.net api-talks.naver.com ssl.pstatic.net 'unsafe-inline' 'self'; img-src 'self' data: ssl.pstatic.net phinf.pstatic.net ndevthumb-phinf.pstatic.net sp.naver.com static.nid.naver.com lcs.naver.com cc.naver.com soundcaptcha.naver.com captcha.naver.com soundcaptcha.nid.naver.com captcha.nid.naver.com; media-src 'self' soundcaptcha.naver.com soundcaptcha.nid.naver.com captcha.nid.naver.com captcha.naver.com; object-src 'self'; report-uri https://nid.naver.com/login/api/csp.repo.naver.only;"},{"name":"content-security-policy","value":"script-src static.nid.naver.com mail.naver.com ntm.pstatic.net api-talks.naver.com ssl.pstatic.net 'unsafe-eval' 'unsafe-inline' 'self'; img-src 'self' data: ssl.pstatic.net phinf.pstatic.net ndevthumb-phinf.pstatic.net sp.naver.com static.nid.naver.com lcs.naver.com cc.naver.com soundcaptcha.naver.com captcha.naver.com soundcaptcha.nid.naver.com captcha.nid.naver.com; media-src 'self' soundcaptcha.naver.com soundcaptcha.nid.naver.com captcha.nid.naver.com captcha.naver.com; object-src 'self' 'unsafe-inline'; report-uri https://nid.naver.com/login/api/csp.repo.naver;"},{"name":"x-content-type-options","value":"nosniff"},{"name":"x-xss-protection","value":"1; mode=block"},{"name":"content-language","value":"ro-RO"},{"name":"cache-control","value":"no-store, no-cache, must-revalidate"},{"name":"content-encoding","value":"gzip"},{"name":"referrer-policy","value":"unsafe-url"},{"name":"server","value":"nfront"}],"content":{"size":4349,"mimeType":"text/html","text":"<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n<meta charset=\"utf-8\">\r\n<meta id=\"viewport\" name=\"viewport\" content=\"width=device-width,initial-scale=1.0\">\r\n<title>2-step Verification : Setup</title>\r\n<link href=\"https://nid.naver.com/favicon_1024.png\" rel=\"apple-touch-icon-precomposed\" sizes=\"1024x1024\" /> \r\n<link rel=\"stylesheet\" type=\"text/css\" />\r\n<link rel=\"stylesheet\" type=\"text/css\" href=\"/inc/mobile/css/myInfo_mobile.css?r=2604161\">\r\n\r\n<script type=\"text/javascript\" src=\"/inc/common/js/jquery.min.js\"></script>\r\n<script type=\"text/javascript\" src=\"/inc/mobile/js/browserMyInfo.js?20251208\"></script>\r\n<script type=\"text/javascript\" src=\"https://nid.naver.com/inc/mobile/js/en/commonUtil.js?20240221\"></script>\r\n<script type=\"text/javascript\" src=\"/inc/common/js/nlog.js?r=202512241\"></script>\r\n<script type=\"text/javascript\" src=\"/inc/common/js/lua.js?r=20220411\"></script>\r\n\r\n<script type=\"text/javascript\">\t\r\n</script>\r\n<meta name=\"decorator\" content=\"MOBILE_NEW_MYINFO\">\r\n</head>\r\n<body id=\"mainBody\" class=\"\" onload=\"setTimeout(function() { window.scrollTo(0, 1) }, 100);\">\r\n<div id=\"wrap\">\r\n\t<div class=\"u_skip\"><a href=\"#content\">본문 바로가기</a></div>\r\n\t<!-- header -->\r\n\t<header role=\"banner\">\r\n<div class=\"header_subindex\">\n\t<!--N로고/네이버ID-->\n\t<div class=\"gnb_area\">\n\t\t<a href=\"https://m.naver.com\" class=\"logo\">\n\t\t\t<span class=\"blind\">NAVER</span>\n\t\t</a>\n\t\t<a href=\"javascript:;\" id=\"accountInfo\" class=\"gnb_title\">\n\t\t\t<h1 class=\"text\">\n\t\t\t\t<span class=\"blind\">네이버ID</span>\n\t\t\t</h1>\n\t\t</a>\n\t</div>\n\t<nav class=\"lnb\">\n\t\t<div class=\"lnb_area\">\n\t\t\t<ul class=\"lnb_list\" role=\"menu\">\n\t\t\t\t<li>\n\t\t\t\t\t<a href=\"javascript:;\" class=\"lnb_item\" role=\"menuitem\">\n\t\t\t\t\t\t<div id=\"nid\" class=\"lnb_text\">My Profile</div>\n\t\t\t\t\t</a>\n\t\t\t\t</li>\n\t\t\t\t<li>\n\t\t\t\t\t<a href=\"javascript:;\" class=\"lnb_item\" role=\"menuitem\">\n\t\t\t\t\t\t<div id=\"security\" class=\"lnb_text\">Security</div>\n\t\t\t\t\t</a>\n\t\t\t\t</li>\n\t\t\t\t<li>\n\t\t\t\t\t<a href=\"javascript:;\" class=\"lnb_item\" role=\"menuitem\">\n\t\t\t\t\t\t<div id=\"manageHistory\" class=\"lnb_text\">Manage History</div>\n\t\t\t\t\t</a>\n\t\t\t\t</li>\n\t\t\t</ul>\n\t\t</div>\n\t</nav>\n</div>\n\n<script type=\"text/JavaScript\">\nvar isMobile = {\n\tiOS: function () {\n\t\t\t return navigator.userAgent.match(/iPhone|iPod/i);\n\t},\n\tiPad: function () {\n\t\t\t return navigator.userAgent.match(/iPad/i);\n\t}\n};\n\nfunction toggleMenu(currentMenu) {\n    var tagList, otherMenu, i;\n\n    if(currentMenu == \"\" || typeof currentMenu == \"undefined\"){\n        $(\"#nid\").addClass(\"on\");\n        return;\n    }\n\n    tagList = \"nid security manageHistory \";\n    otherMenu = tagList.split(\" \");\n\n    for (i = 0; i < otherMenu.length; i++) {\n        if(currentMenu == otherMenu[i]){\n            $(\"#\" + otherMenu[i]).addClass(\"on\");\n        }else if(otherMenu[i].replace(/^\\s+/, \"\") != \"\") {\n            $(\"#\" + otherMenu[i]).removeClass(\"on\");\n        }\n    }\n};\n\n$(document).ready(function() {\n\tvar menu;\n\n\tmenu = \"security\";\n\n\tif(menu == \"\" || menu == \"null\" || menu == null){\n\t\tmenu = \"nid\";\n\t}\n\n\ttoggleMenu(menu);\n\n\t$(document).on(\"click touchstart\", \"#nid\", function(event){\n\t\t sendNlog(this, event, 'lnb.info');\n\t\t \n\t\t var rurl = \"/user2/help/myInfoV2?m=viewProfile&lang=en_US\";\n\t\t $(location).attr('href',rurl);\t\t\n\t});\n\t\n\t$(document).on(\"click touchstart\", \"#security\", function(event){\n\t\t sendNlog(this, event, 'lnb.protect');\n\t\t \n\t\t var rurl = \"/user2/help/myInfoV2?m=viewSecurity&lang=en_US\";\n\t\t $(location).attr('href',rurl);\t\t\n\t});\n\n\t$(document).on(\"click touchstart\", \"#manageHistory\", function(event){\n\t\t sendNlog(this, event, 'lnb.history');\n\n\t\t var rurl = \"/user2/help/myInfoV2?m=viewManageHistory&lang=en_US\";\n\t\t $(location).attr('href',rurl);\n\t});\n});\n</script>\n    \t</header>\r\n\r\n\t<div id=\"content\" class=\"content\" role=\"main\">\r\n\t\t<!-- content -->\r\n\t\t<!-- content -->\n    <div id=\"content\" class=\"otp_loginset\" role=\"main\">\n        <div class=\"section section_pwconfirm\">\n            <!-- 2단계 인증 설정 - 알림발송 -->\n            <div class=\"sh_group\">\n                <h2 class=\"title\">\n                    We`ve sent a notification<br> to <em class=\"green\">Redmi 9C NFC</em>.\n                </h2>\n                <div class=\"progress_time\">\n                    <span class=\"txt\">Remaining time is</span>\n                    <span class=\"time\" id=\"timer\"></span>\n                </div>\n                <div class=\"progress_area\">\n                    <span class=\"blind\">Do you want to approve the 2-Step Verification.</span>\n                </div>\n                <div class=\"btn_area\">\n                    <span class=\"btn_unit_box\"><button type=\"button\" class=\"btn_unit\" id=\"prevButton\">Select another device</button></span>\n                    <span class=\"btn_unit_box\"><button type=\"button\" class=\"btn_unit\" id=\"retryButton\">Request again</button></span>\n                </div>\n                <div class=\"guide_txt\">\n                    * <a id=\"linkHelp\" href=\"https://m.help.naver.com/support/alias/membership/m.membership/m.membership_42.naver\" target=\"_blank\" class=\"blue_underline\">Still haven’t received any notification?</a>\n                </div>\n            </div>\n            <!-- // 2단계 인증 설정 - 알림발송 -->\n        </div>\n    </div>\n\n    <div id=\"needAuthPopup\" class=\"pop_dim\" style=\"display:none;\" tabindex=\"-1\">\n        <div id=\"needAuthDialog\" class=\"otp_popup\" role=\"dialog\" aria-hidden=\"false\">\n            <h2 class=\"title\">Click the following to proceed with the verification.</h2>\n            <p class=\"desc_query\">Within 10 minutes</p>\n            <div class=\"btn_area\">\n                <span id=\"cancelNeedAuth\" class=\"btn_unit_box\"><button type=\"button\" class=\"btn_unit\">Cancel</button></span>\n                <span id=\"proceedNeedAuth\" class=\"btn_unit_box\"><button type=\"button\" class=\"btn_unit on\">Confirm</button></span>\n            </div>\n        </div>\n    </div>\n    <!-- //content -->\n\n<script type=\"text/javascript\">\nvar _timerInterval, _checkPushInterval, _retryCount, _submitFlag, _timeoutFlag, _checkStatusFlag, _endTime, _duration;\n\nfunction initialize() {\n    _submitFlag = false;\n    _timeoutFlag = false;\n    _checkStatusFlag = false;\n    _retryCount = 0;\n    _duration = 10; // 10분\n    displayTimer(_duration, 0, 100); // 10분\n    setTimer();\n    setIntervalForPolling();\n\n\t$(\"#retryButton\").click(retrySendPushMessage);\n    $(\"#prevButton\").click(function() {\n        clearTimer();\n        document.location.href = \"/mobile/user/help/2StepVerif?m=showDeviceList&token_help=a6FMbj88MhsfCTC1\";\n    });\n}\n\nfunction setTimer() {\n\tvar endDate = new Date();\n    endDate.setMinutes(endDate.getMinutes() + _duration); // 10분\n\t_endTime = endDate.getTime();\n\n    _timerInterval = setInterval(function() {\n        var now = new Date();\n        var elapsed = Math.floor((_endTime - now.getTime()) / 1000);\n\n        // timeout\n        if (elapsed <= 0) {\n            doWhenTimeoutForMaximumWait();\n            return;\n        }\n\n        // display\n        var remainMinutes = Math.floor(elapsed / 60);\n        var remainSeconds = elapsed % 60;\n        var remainPercent = Math.floor((elapsed / 60 / _duration) * 100);\n        displayTimer(remainMinutes, remainSeconds, remainPercent);\n\t}, 1000);\n}\n\nfunction displayTimer(remainMinutes, remainSeconds, remainPercent) {\n    if (remainMinutes < 10) {\n        remainMinutes = \"0\" + remainMinutes;\n    }\n    if (remainSeconds < 10) {\n        remainSeconds = \"0\" + remainSeconds;\n    }\n\n    $(\"#timer\").text(remainMinutes + \" : \" + remainSeconds);\n\n\tdisplayProgressBar(remainPercent);\n}\n\nfunction clearTimer() {\n    _timeoutFlag = true;\n    clearInterval(_checkPushInterval);\n    clearInterval(_timerInterval);\n}\n\nfunction doAfterMaximunTimeout() {\n    alert(\"2-step verification failed.\\nPlease check if notification setting is turned on at your NAVER App. If notifications are turned off, 2-step verification  cannot be used.\");\n    document.location.href = \"/mobile/user/help/2StepVerif?m=showDeviceList&token_help=a6FMbj88MhsfCTC1\";\n}\n\nfunction doWhenTimeoutForMaximumWait() {\n    displayTimer(0, 0, 0);\n    if (!_timeoutFlag) {\n        clearTimer();\n        doAfterMaximunTimeout();\n    }\n}\n\nfunction setIntervalForPolling() {\n\t_checkPushInterval = setInterval(checkPushStatus, 2000);\n}\n\n// 중복 submit 방지\nfunction getLock() {\n\tif (_submitFlag || _timeoutFlag) {\n\t\treturn false;\n\t}\n\t_submitFlag = true;\n\treturn true;\n}\n\nfunction releaseLock() {\n\t_submitFlag = false;\n}\n\nfunction alertReturnMessage(resultMessage) {\n\tif (resultMessage) {\n\t\talert(resultMessage.replace(\"\\\\n\", \"\\n\"));\n\t}\n}\n\nfunction retrySendPushMessage() {\n\tif (!getLock()) {\n\t\treturn;\n\t}\n\n\t_retryCount++;\n\tif (_retryCount > 3) {\n        alert(\"You can only retransmit verification notifications up to 3 times. Please try again from the beginning if you would like to be notified again.\");\n        releaseLock();\n        return;\n\t}\n\n\t$.ajax({\n\t\ttype:\"POST\",\n\t\turl: \"/mobile/user/help/2StepVerif?m=retrySendPushMessage&token_help=a6FMbj88MhsfCTC1\",\n\t\tsuccess : function(data) {\n            handleSessionExpiredErr(data);\n\n\t\t\tvar obj = JSON.parse(data);\n\t\t\tif (obj.resultCode == 0) {\n                alertReturnMessage(obj.resultMsg);\n                releaseLock();\n            } else if (obj.resultCode == 1) {\n\t\t\t\tclearTimer();\n                alertReturnMessage(obj.resultMsg);\n\t\t\t\tdocument.location.href = \"/mobile/user/help/2StepVerif?m=setUp&token_help=a6FMbj88MhsfCTC1\";\n            } else if (obj.resultCode == 2) {\n                showNeedAuthPopup();\n\t\t\t} else {\n\t\t\t\tclearTimer();\n                alertReturnMessage(obj.resultMsg);\n\t\t\t\tdocument.location.href = \"/mobile/user/help/2StepVerif?m=showDeviceList&token_help=a6FMbj88MhsfCTC1\";\n\t\t\t}\n\t\t},\n\t\terror : function(xhr, status, error) {\n            alert(\"Temporary error has occurred. Please try again.\");\n            releaseLock();\n\t\t}\n\t});\n}\n\nfunction checkPushStatus() {\n    if (_submitFlag || _timeoutFlag || _checkStatusFlag) {\n        return;\n    }\n\t_checkStatusFlag = true;\n\n\t$.ajax({\n\t\ttype:\"POST\",\n\t\turl: \"/mobile/user/help/2StepVerif?m=checkPushStatus&token_help=a6FMbj88MhsfCTC1\",\n\t\tsuccess : function(data) {\n            handleSessionExpiredErr(data);\n\n            try {\n                var obj = JSON.parse(data);\n                if (obj.resultCode == 1 || !getLock()) {\n                    _checkStatusFlag = false;\n                    return false;\n                }\n                if (obj.resultCode == 0) {\n                    clearTimer();\n                    document.location.href = \"/mobile/user/help/2StepVerif?m=setUp&token_help=a6FMbj88MhsfCTC1\";\n                } else if (obj.resultCode == 2) {\n                    showNeedAuthPopup();\n                } else if (obj.resultCode < 0) {\n                    clearTimer();\n                    alertReturnMessage(obj.resultMsg);\n                    document.location.href = \"/mobile/user/help/2StepVerif?m=showDeviceList&token_help=a6FMbj88MhsfCTC1\";\n                } else {\n                    releaseLock();\n                    _checkStatusFlag = false;\n                }\n\n            } catch (e) {\n                releaseLock();\n                _checkStatusFlag = false;\n                return false;\n            }\n\t\t},\n\t\terror : function(xhr, status, error) {\n\t\t\treleaseLock();\n\t\t\t_checkStatusFlag = false;\n\t\t}\n\t});\n}\n\nfunction handleSessionExpiredErr(data) {\n    if (data && data.indexOf(\"-9|\") === 0) {\n        alertReturnMessage(data.split(\"|\")[1]);\n        document.location.href= \"/mobile/user/help/2StepVerif?lang=en_US\";\n    }\n}\n</script>    <input type=\"hidden\" id=\"token_help\" value=\"a6FMbj88MhsfCTC1\"/>\n    <script type=\"text/javascript\">\n        const nlogLang = \"en\";\n        nlogInit(\"Mmy.private\", \"release\", false, nlogLang);\n\n        $(document).ready(function(){\n            initialize();\n\n            $('#prevButton').click(function() {\n                sendNlog(this, event, '2fs.pushanother');\n            });\n\n            $('#retryButton').click(function() {\n                sendNlog(this, event, '2fs.pushretry');\n            });\n\n            $('#linkHelp').click(function() {\n                sendNlog(this, event, '2fs.pushhelp1');\n            });\n\n            $('#proceedNeedAuth').click(function() {\n                document.location.href = \"/mobile/user/help/2StepVerif?m=proceedNeedAuth&token_help=a6FMbj88MhsfCTC1\";\n            });\n\n            $('#cancelNeedAuth').click(function() {\n                document.location.href = \"/mobile/user/help/2StepVerif?m=viewNeedAuthFail&token_help=a6FMbj88MhsfCTC1\";\n            });\n        });\n\n        function displayProgressBar(remainPercent) {\n            $(\"#progression\").css(\"width\", remainPercent + \"%\");\n            $(\"#progression\").attr(\"aria-valuenow\", remainPercent);\n            $(\"#progression\").attr(\"aria-valuetext\", remainPercent + \"%\");\n        }\n\n        function showNeedAuthPopup() {\n            $('#mainBody').css(\"overflow\", \"hidden\");\n            $('#needAuthDialog').attr('aria-hidden', 'false');\n            $('#needAuthPopup').show();\n        }\n\n        function hideNeedAuthPopup() {\n            $('#needAuthPopup').hide();\n            $('#needAuthDialog').attr('aria-hidden', 'true');\n            $('#mainBody').removeAttr(\"style\");\n        }\n    </script>\r\n\t\r\n\t\t<!-- footer -->\r\n<hr>\r\n\t<footer class=\"footer\" role=\"contentinfo\">\r\n\t\t<p class=\"u_ftlkw\">\r\n\t\t\t\t \t<a href=\"#dummy\" id=\"logout\" class=\"u_ftlk\">Sign-out</a>\r\n\t\t</p>\r\n\t\t\r\n\t\t<p class=\"u_crt\">\r\n\t\t\t<span class=\"u_cri\"><a href=\"#dummy\" id=\"navercorp\" class=\"u_cra u_cra_v1\">&copy;NAVER Corp.</a></span>\r\n\t\t\t<span class=\"u_cri\"><a href=\"#dummy\" id=\"help\" class=\"u_cra\">help</a></span>\r\n\t\t</p>\r\n\t</footer>\r\n<script type=\"text/javascript\">\r\n$(document).ready(function() {\r\n\t$(document).on(\"click touchstart\", \"#navercorp\", function(event){\r\n\t\t sendNlog(this, event, 'fot.navercorp');\r\n\t\t \r\n\t     rurl =\"http://www.navercorp.com/ko/index.nhn\";\r\n\t\t $(location).attr('href',rurl);\t\t\r\n\t});\r\n\t\r\n\t$(document).on(\"click touchstart\", \"#help\", function(event){\r\n\t\tsendNlog(this, event, 'fot.help');\r\n\r\n\t\trurl =\"https://help.naver.com/alias/membership/p.membership/main.naver\";\r\n\t\t$(location).attr('href',rurl);\r\n\t});\r\n\t\r\n\t$(document).on(\"click touchstart\", \"#errorreport\", function(event){\r\n\t\t sendNlog(this, event, 'fot.errorreport');\r\n\t\t \r\n\t     rurl =\"https://m.help.naver.com/support/alias/membership/m.membership/m.membership_12.naver\";\r\n\t\t $(location).attr('href',rurl);\t\t\r\n\t});\t\r\n\t\r\n\t$(document).on(\"click\", \"#logout\", function(event){\r\n\t\t sendNlog(this, event, 'fot.logout');\r\n\t\r\n\t\t if(confirm(\"Are you sure sign out?\") == true) {\r\n\t     \tvar returnUrl = \"https://nid.naver.com/mobile/user/help/naverProfile?lang=en_US\";\r\n\t     \tvar rurl = \"https://nid.naver.com/nidlogin.logout?svctype=262144&url=\" + returnUrl;\r\n\t\t \t$(location).attr('href',rurl);\r\n\t\t }\r\n\t});\r\n\t\r\n\t$(document).on(\"click\", \"#login\", function(event){\r\n\t\tsendNlog(this, event, 'fot.login');\r\n\t\r\n     \tvar returnUrl = \"https://nid.naver.com/mobile/user/help/naverProfile?lang=en_US\";\r\n     \tvar rurl = \"https://nid.naver.com/nidlogin.login?svctype=262144&url=\" + returnUrl;\r\n\t \t$(location).attr('href',rurl);\r\n\t});\r\n\r\n\t$(document).on(\"click\", \"#goPC\", function(event){\r\n\t\tsendNlog(this, event, 'fot.gopc');\r\n\r\n     \tvar rurl = \"https://nid.naver.com/user2/help/myInfo?menu=home\";\r\n\t \t$(location).attr('href',rurl);\r\n\t});\r\n\r\n});\t\r\n</script>\t</div>\r\n</div>\r\n<script type=\"text/javascript\">\r\n$(document).ready(function() {\r\n\r\n    $('#goRedirectPage').css('cursor','pointer');\r\n\t$(document).on(\"click touchstart\", \"#goRedirectPage\", function(event){\r\n\t\t sendNlog(this, event, 'gnb.back');\r\n\r\n\t\t var rurl = \"/user2/help/myInfoV2?lang=en_US\";\r\n\t\t $(location).attr('href',rurl);\r\n\t});\r\n\r\n\t$('#accountInfo').css('cursor','pointer');\r\n\t$(document).on(\"click touchstart\", \"#accountInfo\", function(event){\r\n\t\t sendNlog(this, event, 'gnb.my');\r\n\r\n\t\t $(location).attr('href', \"/user2/help/myInfoV2?lang=\" + 'en_US');\r\n\t});\r\n});\r\n</script>\r\n</body>\r\n</html>"},"redirectURL":"","headersSize":-1,"bodySize":4349}},{"startedDateTime":"2026-04-29T17:04:27.543987Z","time":211,"pageref":"ProxyPin","_id":"mokbn6ot","_app":{"id":"com.nhn.android.search","name":"NAVER","path":"com.nhn.android.search","os":"android"},"request":{"method":"POST","url":"https://nlog.naver.com/n","httpVersion":"HTTP/2","cookies":[],"headers":[{"name":"content-length","value":"1315"},{"name":"sec-ch-ua","value":"\"Chromium\";v=\"114\", \"Whale\";v=\"1\", \"Not)A;Brand\";v=\"99\", \"XWhale\";v=\"28\""},{"name":"sec-ch-ua-platform","value":"\"Android\""},{"name":"sec-ch-ua-mobile","value":"?1"},{"name":"user-agent","value":"Mozilla/5.0 (Linux; Android 11; M2006C3MNG Build/RP1A.200720.011; wv) AppleWebKit/537.36 (KHTML, like Gecko) Version/4.0 Chrome/114.0.0.0 Whale/1.0.0.0 Crosswalk/28.114.0.21 Mobile Safari/537.36 NAVER(inap