/title>\r\n<link href=\"https://nid.naver.com/favicon_1024.png\" rel=\"apple-touch-icon-precomposed\" sizes=\"1024x1024\" /> \r\n<link rel=\"stylesheet\" type=\"text/css\" />\r\n<link rel=\"stylesheet\" type=\"text/css\" href=\"/inc/mobile/css/myInfo_mobile.css?r=2604161\">\r\n\r\n<script type=\"text/javascript\" src=\"/inc/common/js/jquery.min.js\"></script>\r\n<script type=\"text/javascript\" src=\"/inc/mobile/js/browserMyInfo.js?20251208\"></script>\r\n<script type=\"text/javascript\" src=\"https://nid.naver.com/inc/mobile/js/en/commonUtil.js?20240221\"></script>\r\n<script type=\"text/javascript\" src=\"/inc/common/js/nlog.js?r=202512241\"></script>\r\n<script type=\"text/javascript\" src=\"/inc/common/js/lua.js?r=20220411\"></script>\r\n\r\n<script type=\"text/javascript\">\t\r\n</script>\r\n<meta name=\"decorator\" content=\"MOBILE_NEW_MYINFO\">\r\n</head>\r\n<body id=\"mainBody\" class=\"\" onload=\"setTimeout(function() { window.scrollTo(0, 1) }, 100);\">\r\n<div id=\"wrap\">\r\n\t<div class=\"u_skip\"><a href=\"#content\">본문 바로가기</a></div>\r\n\t<!-- header -->\r\n\t<header role=\"banner\">\r\n<div class=\"header_subindex\">\n\t<!--N로고/네이버ID-->\n\t<div class=\"gnb_area\">\n\t\t<a href=\"https://m.naver.com\" class=\"logo\">\n\t\t\t<span class=\"blind\">NAVER</span>\n\t\t</a>\n\t\t<a href=\"javascript:;\" id=\"accountInfo\" class=\"gnb_title\">\n\t\t\t<h1 class=\"text\">\n\t\t\t\t<span class=\"blind\">네이버ID</span>\n\t\t\t</h1>\n\t\t</a>\n\t</div>\n\t<nav class=\"lnb\">\n\t\t<div class=\"lnb_area\">\n\t\t\t<ul class=\"lnb_list\" role=\"menu\">\n\t\t\t\t<li>\n\t\t\t\t\t<a href=\"javascript:;\" class=\"lnb_item\" role=\"menuitem\">\n\t\t\t\t\t\t<div id=\"nid\" class=\"lnb_text\">My Profile</div>\n\t\t\t\t\t</a>\n\t\t\t\t</li>\n\t\t\t\t<li>\n\t\t\t\t\t<a href=\"javascript:;\" class=\"lnb_item\" role=\"menuitem\">\n\t\t\t\t\t\t<div id=\"security\" class=\"lnb_text\">Security</div>\n\t\t\t\t\t</a>\n\t\t\t\t</li>\n\t\t\t\t<li>\n\t\t\t\t\t<a href=\"javascript:;\" class=\"lnb_item\" role=\"menuitem\">\n\t\t\t\t\t\t<div id=\"manageHistory\" class=\"lnb_text\">Manage History</div>\n\t\t\t\t\t</a>\n\t\t\t\t</li>\n\t\t\t</ul>\n\t\t</div>\n\t</nav>\n</div>\n\n<script type=\"text/JavaScript\">\nvar isMobile = {\n\tiOS: function () {\n\t\t\t return navigator.userAgent.match(/iPhone|iPod/i);\n\t},\n\tiPad: function () {\n\t\t\t return navigator.userAgent.match(/iPad/i);\n\t}\n};\n\nfunction toggleMenu(currentMenu) {\n    var tagList, otherMenu, i;\n\n    if(currentMenu == \"\" || typeof currentMenu == \"undefined\"){\n        $(\"#nid\").addClass(\"on\");\n        return;\n    }\n\n    tagList = \"nid security manageHistory \";\n    otherMenu = tagList.split(\" \");\n\n    for (i = 0; i < otherMenu.length; i++) {\n        if(currentMenu == otherMenu[i]){\n            $(\"#\" + otherMenu[i]).addClass(\"on\");\n        }else if(otherMenu[i].replace(/^\\s+/, \"\") != \"\") {\n            $(\"#\" + otherMenu[i]).removeClass(\"on\");\n        }\n    }\n};\n\n$(document).ready(function() {\n\tvar menu;\n\n\tmenu = \"security\";\n\n\tif(menu == \"\" || menu == \"null\" || menu == null){\n\t\tmenu = \"nid\";\n\t}\n\n\ttoggleMenu(menu);\n\n\t$(document).on(\"click touchstart\", \"#nid\", function(event){\n\t\t sendNlog(this, event, 'lnb.info');\n\t\t \n\t\t var rurl = \"/user2/help/myInfoV2?m=viewProfile&lang=en_US\";\n\t\t $(location).attr('href',rurl);\t\t\n\t});\n\t\n\t$(document).on(\"click touchstart\", \"#security\", function(event){\n\t\t sendNlog(this, event, 'lnb.protect');\n\t\t \n\t\t var rurl = \"/user2/help/myInfoV2?m=viewSecurity&lang=en_US\";\n\t\t $(location).attr('href',rurl);\t\t\n\t});\n\n\t$(document).on(\"click touchstart\", \"#manageHistory\", function(event){\n\t\t sendNlog(this, event, 'lnb.history');\n\n\t\t var rurl = \"/user2/help/myInfoV2?m=viewManageHistory&lang=en_US\";\n\t\t $(location).attr('href',rurl);\n\t});\n});\n</script>\n    \t</header>\r\n\r\n\t<div id=\"content\" class=\"content\" role=\"main\">\r\n\t\t<!-- content -->\r\n\t\t<div class=\"section section_pwconfirm\">\r\n\t\t<div class=\"sh_group\">\r\n\t\t\t<div class=\"sh_header\">\r\n\t\t\t\t<h2>Password Confirm</h2>\r\n\t\t\t</div>\r\n\t\t\t<div class=\"sh_content\">\r\n\t\t\t<form id=\"fm\" name=\"fm\" method=\"post\" autocapitalize=\"off\">\r\n\t\t\t\t<input type=\"hidden\" id=\"token_help\" name=\"token_help\" value=\"a6FMbj88MhsfCTC1\" />\r\n\t\t\t\t<input type=\"hidden\" id=\"encPasswd\" name=\"encPasswd\" value=\"\" />\r\n\t\t\t\t<input type=\"hidden\" id=\"encNm\" name=\"encNm\" value=\"\" />\t\t\t\r\n\t\t\t\t<p class=\"info\">Please re-enter your password for security.</p>\r\n\t\t\t\t<fieldset>\r\n\t\t\t\t\t<legend class=\"blind\">Password Confirm</legend>\r\n\t\t\t\t\t<div class=\"input_wrap\">\r\n\t\t\t\t\t\t<span class=\"int int_id\">uykjgg109</span>\r\n\t\t\t\t\t</div>\r\n\t\t\t\t\t<div class=\"input_wrap\">\r\n\t\t\t\t\t\t<label for=\"upw\"  class=\"blind\">Password</label>\r\n\t\t\t\t\t\t<span class=\"int\"><input type=\"password\" id=\"upw\" name=\"upw\" maxlength=\"20\" placeholder=\"Password\"></span>\r\n\t\t\t\t\t\t<button type=\"button\" id=\"btn_upw\" title=\"delete\" class=\"wrg\">삭제 </button>\r\n\t\t\t\t\t</div>\r\n\t\t\t\t\t<div  id=\"d_pswdErr\" class=\"error\" style=\"display:none\"></div>\r\n\t\t\t\t\t<div class=\"btn_area\">\r\n\t\t\t\t\t\t<span><a href=\"#\" id=\"btnCancel\" class=\"btn_model\">Cancel</a></span>\r\n\t\t\t\t\t\t<span><a href=\"#\" id=\"btnConfirm\" class=\"btn_model on\">Confirm</a></span>\r\n\t\t\t\t\t</div>\r\n\t\t\t\t</fieldset>\r\n\t\t\t</form>\r\n\t\t\t</div>\r\n\t\t</div>\r\n\t</div>\r\n\r\n\r\n\r\n<script type=\"text/javascript\" src=\"/inc/mobile/js/clearInputText.js\"></script>\r\n<script type=\"text/javascript\" src=\"/inc/mobile/js/rsaAll.js?r=20240221\"></script>\r\n<script type=\"text/JavaScript\">\r\nconst nlogBase = \"Mmy.protect\";\r\nconst nlogLang = \"en\";\r\nnlogInit(nlogBase, \"release\", false, nlogLang);\r\n\r\nvar topValue = \"pwc.top\"\r\n\r\nonAttachClearInputText(\"upw\", \"btn_upw\");\r\n$(document).ready(function() {\r\n\t$(\"#upw\").focus();\r\n\r\n\t$('html').on('keypress', function(event){\r\n\t\t \r\n\t     if(event.keyCode == 13)\r\n\t     {\r\n\t         $('#btnConfirm').click();\r\n\t\t\t event.preventDefault();\r\n\t     }\r\n\t});\r\n\r\n    $('#upw').css('cursor','pointer');\r\n\t$('#btn_upw').css('cursor','pointer');\r\n\t\r\n\t$('#btnConfirm').css('cursor','pointer');\r\n\t$(document).on(\"click\", \"#btnConfirm\", function(event){\r\n\t\tsendNlog(this, window.event, 'pwc.ok');\r\n\r\n\t\tif ( $(\"#upw\").val() == '' ) {\r\n\t\t\t$(\"#d_pswdErr\").show();\r\n\t\t\t$(\"#d_pswdErr\").text(\"Please enter your password.\");\r\n\t\t\t$(\"#upw\").focus();\r\n\t\t\t\r\n\t\t\treturn;\r\n\t\t}\r\n\t\t\r\n\t\t$.createRsaKey();\r\n\t\t\r\n\t\t$.checkPasswd();\r\n\t});\r\n\r\n\t$('#btnCancel').css('cursor','pointer');\r\n\t$(document).on(\"click\", \"#btnCancel\", function(event){\r\n\t\tsendNlog(this, window.event, 'pwc.cancel');\r\n\t\t\r\n\t\trurl = \"/user2/help/myInfoV2?lang=en_US\";\r\n\t\t$(location).attr(\"href\", rurl);\t\t\r\n\t\t\r\n\t\treturn;\r\n\r\n\t});\t\r\n\r\n\t$.createRsaKey = function() {\r\n\t\tvar rsa = new RSAKey();\r\n\t\tvar sessionKey = \"dhxmbHY8Mhu5POt3\";\r\n\t\tvar keyName = \"100021892\";\r\n\t\tvar eValue = \"9b6a858303445cc8848e114af868c64db3ea1ca3cafb8822d1e3d04a6713b98f6cc8e64835f23ef4a3a3e1c78ca87c2e10a113f3768a48424d1e10e3d98aeb5a394c7f30212370e6ebe65200156370fa1c4e6701ad961508ca08098b7c80bd0a92b5fcd58c11d3e52a879712b83916137f4c7c51c4a9f7027e661c9cc01ca2d1\";\r\n\t\tvar nValue = \"010001\";\r\n\t\tvar id = \"uykjgg109\";\r\n\t\trsa.setPublic(eValue, nValue);\r\n\t    \r\n\t\tif (sessionKey == \"\" || eValue == \"\" || nValue == \"\" || keyName == \"\") {\r\n\t\t\talert(\"Temporary error. Please try again from the beginning.\");\r\n\t\t\trurl = \"/nidlogin.login?svctype=262144&url=http://m.naver.com&locale=en_US\";\r\n\t\t\t$(location).attr(\"href\", rurl);\t\t\t\t\t